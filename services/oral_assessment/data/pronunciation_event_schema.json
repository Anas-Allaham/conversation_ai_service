{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pronunciation requested event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_type", "event_id", "occurred_at", "assessment_id", "response_id", "reference_text", "audio_uri"],
  "properties": {
    "event_type": {"const": "assessment.pronunciation_requested"},
    "event_id": {"type": "string"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "assessment_id": {"type": "string"},
    "response_id": {"type": "string"},
    "reference_text": {"type": "string", "minLength": 1},
    "audio_uri": {"type": "string", "minLength": 1, "description": "Internal URI for encrypted original, unenhanced microphone audio."},
    "callback_url": {"type": ["string", "null"]}
  }
}

