{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/oral-assessment-item-v0.2.0.json",
  "title": "Oral assessment item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "item_id", "version", "status", "source", "target_level", "kind",
    "task_type", "domain", "communicative_functions", "main_prompt",
    "expected_response_seconds", "support_policy", "required_evidence",
    "grammar_independently_scored", "review"
  ],
  "properties": {
    "item_id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
    "version": {"type": "string"},
    "status": {"enum": ["active", "retired", "pilot"]},
    "source": {"const": "original_project_item"},
    "target_level": {"enum": ["A1", "A2", "B1", "B2"]},
    "kind": {"enum": ["normal", "tie_breaker"]},
    "task_type": {"type": "string"},
    "domain": {"type": "string"},
    "communicative_functions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "main_prompt": {"type": "string", "minLength": 10},
    "main_clarification_prompt": {"type": ["string", "null"]},
    "follow_up_prompt": {"type": ["string", "null"]},
    "follow_up_clarification_prompt": {"type": ["string", "null"]},
    "expected_response_seconds": {"$ref": "#/$defs/responseWindow"},
    "follow_up_response_seconds": {"anyOf": [{"$ref": "#/$defs/responseWindow"}, {"type": "null"}]},
    "support_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repeat_prompt", "paraphrase_prompt"],
      "properties": {
        "repeat_prompt": {"type": "integer", "minimum": 0, "maximum": 3},
        "paraphrase_prompt": {"const": false}
      }
    },
    "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "grammar_independently_scored": {"const": false},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "reviewer", "review_status", "reviewed_at", "notes"],
      "properties": {
        "author": {"type": "string"},
        "reviewer": {"type": "string"},
        "review_status": {"enum": ["approved", "pilot", "retired"]},
        "reviewed_at": {"type": "string"},
        "notes": {"type": "string"}
      }
    }
  },
  "$defs": {
    "responseWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {"type": "integer", "minimum": 1},
        "maximum": {"type": "integer", "minimum": 1}
      }
    }
  }
}
