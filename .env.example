# Runtime mode: local, test, staging, or production
APP_ENV=local
LOG_LEVEL=INFO

# LiveKit supplies these automatically to a LiveKit Cloud deployment.
# They are required for local console/dev mode.
LIVEKIT_URL="wss://realtimne-english-tutor-xedx2w8p.livekit.cloud"
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=english-tutor

# Streaming providers
DEEPGRAM_API_KEY=
LIVEKIT_LLM_MODEL=google/gemini-2.5-flash-lite
DEEPGRAM_TTS_MODEL=aura-2-andromeda-en

# Local zero-configuration database. Production must replace this with the
# team's PostgreSQL URL; postgresql:// is normalized to asyncpg automatically.
DATABASE_URL=sqlite+aiosqlite:///./data/conversation_ai.db
# Production example:
# DATABASE_URL=postgresql://user:password@db.example.com:5432/conversation_ai

# Required by the internal FastAPI service.
SERVICE_API_KEY=

# Integrated tutor modules. They share this API process and DATABASE_URL.
TUTOR_ENABLED=true
TUTOR_REQUIRED=true
# Leave these empty to reuse DATABASE_URL and SERVICE_API_KEY respectively.
ASSESSMENT_DATABASE_URL=
ASSESSMENT_SERVICE_TOKEN=
ASSESSMENT_ADMIN_TOKEN=replace-with-a-different-long-random-token
ASSESSMENT_SERVICE_URL=http://127.0.0.1:8000
ASSESSMENT_LOG_LEVEL=INFO
ASSESSMENT_RATE_LIMIT_PER_MINUTE=120
ASSESSMENT_REQUEST_TIMEOUT_SECONDS=90
ASSESSMENT_MAX_BODY_BYTES=5242880

# Placement evaluator (Gemini is the production default).
EVALUATOR_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_VERSION=v1beta
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
EVALUATOR_TIMEOUT_SECONDS=15
EVALUATOR_MAX_RETRIES=3
EVALUATOR_MAX_RETRY_WAIT_SECONDS=60
ALLOW_HEURISTIC_EVALUATOR=false

# Versioned placement, fluency, and guided-practice contracts.
ASSESSMENT_VERSION=0.7.0
ITEM_BANK_VERSION=0.2.0
RUBRIC_VERSION=0.3.0
SCORER_VERSION=0.3.0
FLUENCY_SCORER_VERSION=fluency-v0.1
STORE_ALL_ASSESSMENT_AUDIO=false

# Optional encrypted raw-audio storage.
AUDIO_STORAGE_BACKEND=local
AUDIO_STORAGE_ROOT=./data/audio
AUDIO_ENCRYPTION_KEY=
AUDIO_RETENTION_DAYS=30
S3_BUCKET=
S3_PREFIX=oral-assessment
S3_REGION=
S3_KMS_KEY_ID=
PRONUNCIATION_SERVICE_URL=
PRONUNCIATION_SERVICE_TOKEN=
GUIDED_SERVICE_PUBLIC_URL=

# Guided mode: the model is downloaded once; runtime synthesis is local.
PIPER_REQUIRED=true
PIPER_VOICE=en_US-lessac-medium
PIPER_MODEL_PATH=./data/piper/en_US-lessac-medium.onnx
PIPER_LENGTH_SCALE=1.0
PIPER_VOLUME=1.0
PIPER_REPLAY_LEARNER_LENGTH_SCALE=1.06
PIPER_REPLAY_PAUSE_SECONDS=0.32

# Placement worker's deliberately patient turn handling.
ASSESSMENT_FLUX_EOT_THRESHOLD=0.90
ASSESSMENT_FLUX_EOT_TIMEOUT_MS=10000
ASSESSMENT_ENDPOINTING_MODE=fixed
ASSESSMENT_ENDPOINTING_MIN_DELAY_SECONDS=1.50
ASSESSMENT_ENDPOINTING_MAX_DELAY_SECONDS=4.00
ASSESSMENT_RESPONSE_COLLECTION_DELAY_SECONDS=4.00
ASSESSMENT_MIN_INTERRUPTION_DURATION_SECONDS=0.50
ASSESSMENT_TTS_TIMEOUT_SECONDS=20
ASSESSMENT_TTS_MAX_RETRIES=4
ASSESSMENT_AUDIO_ENHANCEMENT=quail_l
ASSESSMENT_AUDIO_ENHANCEMENT_LEVEL=

# Shared fluency-v0.1 evidence thresholds.
FLUENCY_PAUSE_THRESHOLD_SECONDS=0.50
FLUENCY_LONG_PAUSE_THRESHOLD_SECONDS=1.50
FLUENCY_MINIMUM_TURN_WORDS=5
FLUENCY_MINIMUM_TURN_SECONDS=2.50
FLUENCY_ASSESSMENT_MINIMUM_TURNS=2
FLUENCY_ASSESSMENT_MINIMUM_SPEECH_SECONDS=12
FLUENCY_CONVERSATION_MINIMUM_TURNS=3
FLUENCY_CONVERSATION_TARGET_TURNS=5
FLUENCY_CONVERSATION_MINIMUM_SPEECH_SECONDS=30

# Conversation pipeline tuning
LLM_TEMPERATURE=0.30
LLM_MAX_COMPLETION_TOKENS=320
AEC_WARMUP_SECONDS=1.0
AUDIO_ENHANCEMENT=quail_l
AUDIO_ENHANCEMENT_LEVEL=
FLUX_EAGER_EOT_THRESHOLD=0.60
FLUX_EOT_THRESHOLD=0.80
FLUX_EOT_TIMEOUT_MS=7000
