# Runtime mode: local, test, staging, or production
APP_ENV=local
LOG_LEVEL=INFO

# LiveKit supplies these automatically to a LiveKit Cloud deployment.
# They are required for local console/dev mode.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=english-tutor

# Streaming providers
DEEPGRAM_API_KEY=
LIVEKIT_LLM_MODEL=google/gemini-2.5-flash-lite
DEEPGRAM_TTS_MODEL=aura-2-andromeda-en

# AI-owned PostgreSQL database. postgresql:// is normalized to asyncpg.
DATABASE_URL=postgresql://user:password@host:5432/conversation_ai

# Required by the internal FastAPI service.
SERVICE_API_KEY=

# Assessment and guided-practice service
ASSESSMENT_SERVICE_URL=http://127.0.0.1:8080
ASSESSMENT_SERVICE_TOKEN=
ASSESSMENT_ADMIN_TOKEN=
ASSESSMENT_DATABASE_URL=sqlite:///data/assessment.db
GUIDED_SERVICE_PUBLIC_URL=http://127.0.0.1:8080
ASSESSMENT_SERVICE_ENABLED=true

# Structured assessment evaluator. Heuristic mode is for local tests only.
EVALUATOR_PROVIDER=gemini
ALLOW_HEURISTIC_EVALUATOR=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_VERSION=v1beta
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
EVALUATOR_TIMEOUT_SECONDS=15
EVALUATOR_MAX_RETRIES=3
EVALUATOR_MAX_RETRY_WAIT_SECONDS=60

# Versioned assessment, fluency, and guided content
ASSESSMENT_VERSION=0.6.0
ITEM_BANK_VERSION=0.2.0
RUBRIC_VERSION=0.3.0
SCORER_VERSION=0.3.0
FLUENCY_SCORER_VERSION=fluency-v0.1

# Optional consented raw-audio and pronunciation integration
STORE_ALL_ASSESSMENT_AUDIO=false
AUDIO_STORAGE_BACKEND=local
AUDIO_STORAGE_ROOT=data/audio
AUDIO_ENCRYPTION_KEY=
AUDIO_RETENTION_DAYS=30
PRONUNCIATION_SERVICE_URL=
PRONUNCIATION_SERVICE_TOKEN=
S3_BUCKET=
S3_PREFIX=oral-assessment
S3_REGION=
S3_KMS_KEY_ID=

# Conversation pipeline tuning
LLM_TEMPERATURE=0.30
LLM_MAX_COMPLETION_TOKENS=320
AEC_WARMUP_SECONDS=1.0
AUDIO_ENHANCEMENT=quail_l
AUDIO_ENHANCEMENT_LEVEL=
FLUX_EAGER_EOT_THRESHOLD=0.60
FLUX_EOT_THRESHOLD=0.80
FLUX_EOT_TIMEOUT_MS=7000

# Assessment turns use more conservative endpointing than free practice.
ASSESSMENT_FLUX_EOT_THRESHOLD=0.90
ASSESSMENT_FLUX_EOT_TIMEOUT_MS=10000
ASSESSMENT_RESPONSE_COLLECTION_DELAY_SECONDS=4.0
ASSESSMENT_TTS_TIMEOUT_SECONDS=20
ASSESSMENT_TTS_MAX_RETRIES=4
