# Runtime mode: local, test, staging, or production
APP_ENV=local
LOG_LEVEL=INFO

# LiveKit supplies these automatically to a LiveKit Cloud deployment.
# They are required for local console/dev mode.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Streaming providers
DEEPGRAM_API_KEY=
LIVEKIT_LLM_MODEL=google/gemini-2.5-flash-lite
DEEPGRAM_TTS_MODEL=aura-2-andromeda-en

# AI-owned PostgreSQL database. postgresql:// is normalized to asyncpg.
DATABASE_URL=postgresql://user:password@host:5432/conversation_ai

# Required only by the FastAPI query/delete service.
SERVICE_API_KEY=

# Conversation pipeline tuning
LLM_TEMPERATURE=0.30
LLM_MAX_COMPLETION_TOKENS=320
AEC_WARMUP_SECONDS=1.0
AUDIO_ENHANCEMENT=quail_l
AUDIO_ENHANCEMENT_LEVEL=
FLUX_EAGER_EOT_THRESHOLD=0.60
FLUX_EOT_THRESHOLD=0.80
FLUX_EOT_TIMEOUT_MS=7000

